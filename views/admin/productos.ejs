<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Productos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

    <!-- Navbar Admin -->
    <nav class="navbar">
        <div class="logo">
        <img src="/img/productos/pizzeriia-umaru.png">
        <span id="logo-text">Pizza-chan ピッツェリアちゃん</span>
        </div>
        <ul class="nav-links">
            <li><a href="/admin/categorias">Categorías</a></li>
            <li><a href="/admin/productos">Productos</a></li>
            <li><a href="#" id="btnCerrarSesion">Cerrar sesión</a></li>
        </ul>
    </nav>

    <section>
        <h2>Gestión de Productos</h2>

        <!-- Formulario -->
        <div class="card" style="max-width:500px; margin:0 auto 30px auto;">
            <h3 id="form-titulo">Nuevo Producto</h3>
            <input type="hidden" id="prod-id">
            <input type="text" id="prod-codigo" placeholder="Código" class="input-admin">
            <input type="text" id="prod-nombre" placeholder="Nombre" class="input-admin">
            <input type="text" id="prod-descripcion" placeholder="Descripción" class="input-admin">
            <input type="number" id="prod-precio" placeholder="Precio" class="input-admin">
            <select id="prod-categoria" class="input-admin">
                <option value="">Selecciona categoría</option>
            </select>
            <input type="file" id="prod-imagen" accept="image/*" class="input-admin">
            <div class="botones" style="margin-top:10px;">
                <button class="btn" id="btnGuardarProducto">Guardar</button>
                <button class="btn" id="btnLimpiarProducto" style="background:#95a5a6">Limpiar</button>
            </div>
            <div id="msg-producto" style="margin-top:10px;"></div>
        </div>

        <!-- Tabla -->
        <div style="max-width:900px; margin:0 auto;">
            <table class="tabla-admin">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Imagen</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Categoría</th>
                        <th>Status</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-productos"></tbody>
            </table>
        </div>
    </section>
    <script src="/js/admin/auth.js"></script>
    <script src="/js/admin/productos.js"></script>
    <script type="module" src="/js/admin/animation.js"></script>
</body>
</html>
